   "source": [
    "##### 使用 global 讓函式存取全域變數的值"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Alex\n",
      "Alex\n",
      "全域變數 name: Alex\n"
     ]
    }
   ],
   "source": [
    "# 全域變數\n",
    "name = \"Jarvis\"\n",
    "\n",
    "# 定義函式\n",
    "def get_name():\n",
    "    global name\n",
    "    name = \"Alex\"\n",
    "    return name\n",
    "\n",
    "# 執行函式\n",
    "result = get_name()\n",
    "\n",
    "# 輸出 name\n",
    "print(result)\n",
    "print(name)\n",
    "print(f\"全域變數 name: {name}\")"
   ]
  }
 ],
